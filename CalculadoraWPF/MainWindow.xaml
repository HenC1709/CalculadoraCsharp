<Window x:Class="CalculadoraWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Calculadora WPF"
        Height="750"
        Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <ScrollViewer>

        <Grid Margin="20">

            <StackPanel>

                <!-- TITULO -->

                <TextBlock Text="CALCULADORA WPF"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 25"/>

                <!-- OPERACIONES BASICAS -->

                <Border Background="#2D2D30"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0 0 0 20">

                    <StackPanel>

                        <TextBlock Text="Operaciones Básicas"
                                   FontSize="22"
                                   Foreground="White"
                                   Margin="0 0 0 15"/>

                        <TextBlock Text="Expresión matemática"
                                   Foreground="LightGray"/>

                        <TextBox x:Name="txtExpresion"
                                 Height="35"
                                 FontSize="16"
                                 Margin="0 5 0 10"/>

                        <Button Content="Calcular"
                                Height="35"
                                FontSize="16"
                                Click="Calcular_Click"/>

                        <TextBlock x:Name="txtResultado"
                                   FontSize="18"
                                   Foreground="LightGreen"
                                   Margin="0 15 0 0"/>

                    </StackPanel>

                </Border>

                <!-- POTENCIA -->

                <Border Background="#2D2D30"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0 0 0 20">

                    <StackPanel>

                        <TextBlock Text="Potencia"
                                   FontSize="22"
                                   Foreground="White"
                                   Margin="0 0 0 15"/>

                        <TextBlock Text="Base"
                                   Foreground="LightGray"/>

                        <TextBox x:Name="txtBase"
                                 Height="35"
                                 FontSize="16"
                                 Margin="0 5 0 10"/>

                        <TextBlock Text="Exponente"
                                   Foreground="LightGray"/>

                        <TextBox x:Name="txtExponente"
                                 Height="35"
                                 FontSize="16"
                                 Margin="0 5 0 10"/>

                        <Button Content="Calcular Potencia"
                                Height="35"
                                FontSize="16"
                                Click="Potencia_Click"/>

                        <TextBlock x:Name="txtPotenciaResultado"
                                   FontSize="18"
                                   Foreground="LightGreen"
                                   Margin="0 15 0 0"/>

                    </StackPanel>

                </Border>

                <!-- RAIZ -->

                <Border Background="#2D2D30"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0 0 0 20">

                    <StackPanel>

                        <TextBlock Text="Raíz Cuadrada"
                                   FontSize="22"
                                   Foreground="White"
                                   Margin="0 0 0 15"/>

                        <TextBlock Text="Número"
                                   Foreground="LightGray"/>

                        <TextBox x:Name="txtRaiz"
                                 Height="35"
                                 FontSize="16"
                                 Margin="0 5 0 10"/>

                        <Button Content="Calcular Raíz"
                                Height="35"
                                FontSize="16"
                                Click="Raiz_Click"/>

                        <TextBlock x:Name="txtRaizResultado"
                                   FontSize="18"
                                   Foreground="LightGreen"
                                   Margin="0 15 0 0"/>

                    </StackPanel>

                </Border>

                <!-- IMC -->

                <Border Background="#2D2D30"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0 0 0 20">

                    <StackPanel>

                        <TextBlock Text="Calculadora IMC"
                                   FontSize="22"
                                   Foreground="White"
                                   Margin="0 0 0 15"/>

                        <TextBlock Text="Nombre"
                                   Foreground="LightGray"/>

                        <TextBox x:Name="txtNombre"
                                 Height="35"
                                 FontSize="16"
                                 Margin="0 5 0 10"/>

                        <TextBlock Text="Fecha de nacimiento"
                                   Foreground="LightGray"/>

                        <DatePicker x:Name="dpFechaNacimiento"
                                    Margin="0 5 0 10"/>

                        <TextBlock Text="Peso (kg)"
                                   Foreground="LightGray"/>

                        <TextBox x:Name="txtPeso"
                                 Height="35"
                                 FontSize="16"
                                 Margin="0 5 0 10"/>

                        <TextBlock Text="Altura (m)"
                                   Foreground="LightGray"/>

                        <TextBox x:Name="txtAltura"
                                 Height="35"
                                 FontSize="16"
                                 Margin="0 5 0 10"/>

                        <Button Content="Calcular IMC"
                                Height="35"
                                FontSize="16"
                                Click="IMC_Click"/>

                        <TextBlock x:Name="txtIMCResultado"
                                   FontSize="18"
                                   Foreground="LightGreen"
                                   Margin="0 15 0 0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Window>